        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"pay_test_id\",\n        \"order_id\": \"order_R1M29uAfftiScn\",\n        \"amount\": 50000\n      }\n    }\n  }\n}"
        },
